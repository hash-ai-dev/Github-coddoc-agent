{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "module": "commonjs",
        "lib": [
            "ES2020",
            "DOM"
        ],
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "outDir": "dist-electron",
        "rootDir": ".",
        "esModuleInterop": true,
        "types": [
            "node"
        ],
        "composite": true
    },
    "include": [
        "src/main/**/*.ts"
    ]
}