{
  "name": "doc-agent",
  "private": true,
  "version": "1.0.0",
  "main": "dist-electron/src/main/main.js",
  "description": "AI Desktop Agent for Github Documentation",
  "author": "Antigravity",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite\" \"npm run watch:main\" \"npm run start:electron\"",
    "build:main": "tsc -p tsconfig.node.json",
    "watch:main": "tsc -p tsconfig.node.json -w",
    "start:electron": "wait-on tcp:5173 && electron .",
    "build": "tsc -p tsconfig.node.json && vite build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "clsx": "^2.1.0",
    "electron-store": "^8.1.0",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-highlight": "^7.0.2",
    "tailwind-merge": "^2.2.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.20",
    "@types/react": "^18.2.58",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^29.1.0",
    "electron-builder": "^24.12.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.docagent.app",
    "productName": "DocAgent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist-electron/**/*",
      "dist-vite/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!env",
          "!**/__pycache__"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
